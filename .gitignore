# =====================================================================
# robotics .gitignore — keep `git status` showing only real changes
# =====================================================================

# ---- Python ---------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# ---- Editor / IDE / runtime UI state --------------------------------
.vscode/
.polyscope.ini
imgui.ini
Oli_____Robot_Brain.ini
MUJOCO_LOG.TXT

# ---- Tool caches ----------------------------------------------------
.cache/
.superpowers/
.venv/
.claude/workflows/
.claude/worktrees/
vbti/vla/.claude/agent-memory/
# UI trace screenshots — session scratch from scripts/uitest runs
vbti/inspection/ui/tools/trace-*.png

# ---- ML training run outputs (regeneratable artifacts) --------------
wandb/
outputs/
vbti/vla/outputs/
vbti/vla/experiments/**/lerobot_output*/
vbti/vla/experiments/**/eval/
vbti/vla/experiments/**/eval_sessions/
vbti/vla/experiments/**/checkpoints/

# ---- Heavy experiment data (datasets / raw sensor dumps) ------------
vbti/vla/experiments/enea/
vbti/vla/experiments/duck_cup_smolvla/v016/data/d405_gripper_sample/color_uint8.npy
vbti/vla/experiments/duck_cup_smolvla/v016/data/d405_gripper_sample/depth_uint16.npy
vbti/vla/research/how_to_mask_right/cached_frames/
vbti/vla/research/how_to_mask_right/exp01_umap/images/
vbti/vla/tmp_data/
vbti/vla/data/
vbti/vla/env/

# ---- Vendored / cloned external libs (re-clone per machine) ---------
vbti/vla/libs/
lerobot/
leisaac/
datasets/
models/

# ---- Old diffusion experiment artifacts -----------------------------
old/wandb/
old/diffusion/data/
old/diffusion/models/
old/diffusion/results/
old/diffusion/gym_pusht/
old/diffusion/model_src/partial_movie_files/
old/diffusion/model_src/.ipynb_checkpoints/
old/diffusion/model_src/*.mp4

# ---- Vendor submodule runtime logs ----------------------------------
vbti/humanoid/vendor/humanoid-mujoco-sim/MUJOCO_LOG.TXT

# ---- Oli Main Software vendored payload (downloaded per-machine) ----
# Tracked in repo: README + manifest.yaml + .gitignore inside the dir.
# Untracked: the 2.5 GB install/ payload.
vbti/humanoid/vendor/oli-main-software-*/install/

# ---- nvidia-corpus: its OWN separate git repo, parked next to oli-corpus --
# Adjacent on disk for convenience, but NOT part of this monorepo — it has its
# own .git and is maintained/committed independently. Keep it fully ignored here.
vbti/humanoid/docs/nvidia-corpus/

# ---- Inspection project ---------------------------------------------
# NOTE: git does NOT support inline comments. `#` only opens a comment at the
# START of a line, so `third_party/   # sparse clones` was a pattern that
# literally contained "   # sparse clones" and matched nothing. The three
# rules below had never ignored anything. Keep every comment on its own line.

# sparse clones (SO-ARM100 URDF); re-fetch, don't vendor
third_party/
# capture bundles, from back when project data sat in a root-level data/
data/inspection/
# accidental capture dirs from running inside vbti/logic
vbti/vla/logic/data/

# Project data lives under inspection/data/ now, which the root-anchored rule
# above never matched — 417 MB of run captures were one `git add .` away from
# the history. Recorded runs are evidence, not source: they are the only copy
# of what the robot did with the code of that day, so they get backed up,
# never versioned. `inspection/data/isaac_models/` stays TRACKED — those are
# authored CAD assets, an input rather than an output.
vbti/inspection/data/runs/
vbti/inspection/data/inspection/
# regenerable from runs by step_replay + the fit bank (spec 2026-09-03)
vbti/inspection/data/derived/
# regenerable by investigation/fill_probe.py and hull_blueprint.py
vbti/inspection/data/framing/
vbti/inspection/data/tool/
# heavy outputs of the IWM research experiments (masks, clouds, arrays); what a
# report shows is committed next to it in investigation/iwm/<experiment>/evidence/
vbti/inspection/data/iwm/
vbti/inspection/cell/topview.png

# browser-automation snapshots
.playwright-mcp/

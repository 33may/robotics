{
  "name": "@porthole/framework",
  "version": "0.1.0",
  "description": "Bus client, panel host and docking shell. The tier you depend on and never edit.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./src/theme/theme.css"
  },
  "files": [
    "dist",
    "src/theme"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3"
  },
  "peerDependencies": {
    "dockview-react": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
